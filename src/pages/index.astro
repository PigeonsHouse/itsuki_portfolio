---
import BaseLayout from "../layouts/base.astro";

const works: any[] = Object.values(
  import.meta.glob("./works/*.md", {
    eager: true,
  }),
);
const sortedWorks = works.sort((a, b) => a.frontmatter.id - b.frontmatter.id);
---

<BaseLayout title="Works">
  <section class="works-section">
    <h2>Works</h2>
    {
      sortedWorks.map((post) => (
        <div>
          <a href={post.url}>{post.frontmatter.title}</a>
        </div>
      ))
    }
  </section>
</BaseLayout>
