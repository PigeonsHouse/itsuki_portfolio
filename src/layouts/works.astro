---
import BaseLayout from "./base.astro";

const { frontmatter: {title, opus, year, instrumentation, thumbnail, links} } = Astro.props;
---

<style>
  .thumbnail {
    width: 360px;
    height: 360px;
  }
</style>

<BaseLayout title={title}>
  <div><a href="/">TOP</a></div>

  <img class="thumbnail" src={thumbnail} />

  <div>{opus}</div>
  <h1>{title}</h1>
  <div>{year}・{instrumentation}</div>

  {links && (
    <div>{links.youtube && <a href={links.youtube}>Youtube</a>}</div>
    <div>{links.linkcore && <a href={links.linkcore}>Streaming</a>}</div>
  )}

  <h2>Program Note</h2>
  <slot />
</BaseLayout>
